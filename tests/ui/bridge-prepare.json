{
  "schema_version": 1,
  "name": "bridge-prepare",
  "mutation": "transient",
  "setup": {
    "workflow": "dancing",
    "mode": "play",
    "viewport": {
      "width": 1280,
      "height": 800
    }
  },
  "steps": [
    {"op": "activate", "control": "select clip ui-test-clip"},
    {"op": "wait", "condition": {"kind": "surface", "field": "media.loaded", "operator": "eq", "value": true}, "timeout_ms": 1000},
    {"op": "activate", "control": "play pause clip"},
    {"op": "assert", "condition": {"kind": "surface", "field": "playback.active", "operator": "eq", "value": false}},
    {"op": "assert", "condition": {"kind": "control", "field": "player full screen toggle", "operator": "enabled"}}
  ]
}
