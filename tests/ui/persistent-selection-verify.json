{
  "schema_version": 1,
  "name": "persistent-list-selection-verify",
  "mutation": "transient",
  "setup": {
    "workflow": "dancing",
    "mode": "play",
    "viewport": {
      "width": 1280,
      "height": 800
    }
  },
  "steps": [
    {"op": "assert", "condition": {"kind": "surface", "field": "selection.source.saved", "operator": "eq", "value": "ui-test-source"}},
    {"op": "assert", "condition": {"kind": "surface", "field": "selection.clip.saved", "operator": "eq", "value": "ui-test-clip"}},
    {"op": "assert", "condition": {"kind": "surface", "field": "selection.id", "operator": "eq", "value": "ui-test-clip"}},
    {"op": "wait", "condition": {"kind": "surface", "field": "video.frame_ready", "operator": "eq", "value": true}, "timeout_ms": 500},
    {"op": "assert", "condition": {"kind": "surface", "field": "playback.active", "operator": "eq", "value": false}}
  ]
}
